<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FB"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layoutDirection="rtl">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حسابداری بیمه ثالث" android:textSize="25sp" android:textStyle="bold" android:textColor="#0D47A1" android:gravity="center" android:padding="12dp"/>
<TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="داشبورد مدیریتی • نسخه ۲۰۲۶" android:textSize="15sp" android:gravity="center" android:paddingBottom="12dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/addBtn" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="ثبت بیمه‌نامه"/><Space android:layout_width="8dp" android:layout_height="1dp"/><Button android:id="@+id/reportBtn" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="گزارش‌ها"/></LinearLayout>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="55dp" android:hint="جستجوی شماره بیمه‌نامه یا نام بیمه‌گذار" android:inputType="text" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/listTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بیمه‌نامه‌های ثبت‌شده" android:textStyle="bold" android:textSize="18sp" android:padding="12dp"/>
<LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout></ScrollView>
